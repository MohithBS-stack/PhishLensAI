# PhishLens AI Backend Environment Configuration
PROJECT_NAME="PhishLens AI API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ORIGIN_REGEX="^https:\/\/(phishlens-ai|phish-lens-ai|phishlensai)[a-z0-9-]*\.vercel\.app$"

# Model paths
URL_MODEL_PATH="models/saved/url_classifier.joblib"
SMS_MODEL_PATH="models/saved/sms_classifier.joblib"

# Optional LLM Explanation (Gemini API)
# If omitted or invalid, the backend automatically engages the deterministic rule-grounded generator
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
ENABLE_LLM_EXPLANATION=true
LLM_TIMEOUT_SECONDS=5.0

# Deterministic Risk Scoring Thresholds
RISK_THRESHOLD_HIGH=70.0
RISK_THRESHOLD_SUSPICIOUS=30.0

# Phase 1: Database & Authentication (Render Managed PostgreSQL)
# Example PostgreSQL URL: postgresql+asyncpg://user:password@hostname:5432/dbname
# In development, defaults to sqlite+aiosqlite:///./phishlens_dev.db if omitted
DATABASE_URL=""

# JWT Secret & Expirations (Never commit real secrets)
JWT_SECRET_KEY="dev-insecure-jwt-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cookie Configuration for Cross-Origin Refresh Tokens (Vercel <-> Render)
# In production (ENVIRONMENT="production"), defaults are Secure=true, SameSite="none"
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"
COOKIE_DOMAIN=""

# Set to true only if behind a trusted reverse proxy that strips client-spoofed X-Forwarded-For headers
TRUST_FORWARDED_FOR=false
